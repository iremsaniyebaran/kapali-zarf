# Copy to .env. Never commit .env.

# Monad testnet RPC endpoints. Public QuickNode below; it answers "requests limited to 15/sec" under
# load, so every script shares one rate limiter (RPC_RPS). Give the stage page a different endpoint,
# e.g. https://rpc-testnet.monadinfra.com / wss://rpc-testnet.monadinfra.com in web/.env.local.
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_WSS=wss://testnet-rpc.monad.xyz

# Faucet-funded wallet (OWNER): deploys, owns the oracle, tops up the demo wallets. Keep at least 15 MON.
DEPLOYER_PK=

# Optional: auction windows in blocks, read at deploy time. Start at 8/8, measure, then shorten to 3-5.
# COMMIT_BLOCKS=8
# REVEAL_BLOCKS=8

# Optional
# DROP_PORT=8787
# DROP_PRICE=900
# PRIORITY_GWEI=2
# RPC_RPS=12
# MIN_GAS_MON=1
# GAS_TOPUP_MON=1.5
# EXPLORER_TX_URL=https://testnet.monadvision.com/tx/

# npm run wallets appends ELIF_KLASIK_PK, ELIF_ZARF_PK, BOT_A_PK, BOT_B_PK, BOT_C_PK, FAST_BOT_PK, GUEST_PK below.
