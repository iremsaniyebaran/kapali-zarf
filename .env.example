# Copy to .env. Never commit .env.

# Your own Monad testnet RPC endpoint (with API key).
MONAD_TESTNET_RPC=

# Faucet-funded wallet: deploys, owns the oracle, tops up the demo wallets. Keep at least 15 MON.
DEPLOYER_PK=

# Optional: auction windows in blocks, read at deploy time.
# COMMIT_BLOCKS=3
# REVEAL_BLOCKS=3

# Optional
# POLL_MS=200
# DROP_PRICE=900
# EXPLORER_TX_URL=https://testnet.monadscan.com/tx/

# npm run wallets appends ELIF_KLASIK_PK, ELIF_ZARF_PK, BOT_A_PK, BOT_B_PK, BOT_C_PK, FAST_BOT_PK below.
