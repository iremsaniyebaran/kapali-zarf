# Copy to .env. Never commit .env.

# Your own Monad testnet RPC endpoints (with API key). The public ones allow ~25 requests/second;
# give the bots and the stage page different endpoints.
MONAD_TESTNET_RPC=
MONAD_TESTNET_WSS=

# Faucet-funded wallet (OWNER): deploys, owns the oracle, tops up the demo wallets. Keep at least 15 MON.
DEPLOYER_PK=

# Optional: auction windows in blocks, read at deploy time. Start at 8/8, measure, then shorten to 3-5.
# COMMIT_BLOCKS=8
# REVEAL_BLOCKS=8

# Optional
# DROP_PORT=8787
# DROP_PRICE=900
# PRIORITY_GWEI=2
# MIN_GAS_MON=1
# GAS_TOPUP_MON=1.5
# EXPLORER_TX_URL=https://testnet.monadvision.com/tx/

# npm run wallets appends ELIF_KLASIK_PK, ELIF_ZARF_PK, BOT_A_PK, BOT_B_PK, BOT_C_PK, FAST_BOT_PK below.
